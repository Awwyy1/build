---
/**
 * A photograph, or a labelled placeholder while none exists yet.
 *
 * Fills its container, so the parent controls the shape. Images go through
 * Astro's pipeline: each is re-encoded to WebP and emitted at several
 * widths, and the browser picks one using `sizes`. Give `sizes` the width
 * the image will actually occupy, or the browser will assume the full
 * viewport and fetch more than it needs.
 */
import { Image } from 'astro:assets';
import type { PhotoSrc } from '../config/media';

interface Props {
  src: PhotoSrc;
  /** Translated alt text. Also labels the placeholder for screen readers. */
  alt: string;
  /** Translated word for "photograph", shown on the empty slot. */
  placeholder: string;
  /** Rendered width at each breakpoint. Defaults to a full-width block. */
  sizes?: string;
  eager?: boolean;
}

const { src, alt, placeholder, sizes = '100vw', eager = false } = Astro.props;

/*
 * Widths to emit. Capped at 1600: beyond that the file grows faster than
 * the picture improves at the sizes this layout uses.
 */
const widths = [480, 800, 1200, 1600];
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover"
    />
  ) : (
    <div class="tex-strata relative h-full w-full" role="img" aria-label={alt}>
      {/*
        Cornered rather than centred: the hero slot is the full viewport and
        a centred label would land on top of the headline.
      */}
      <span
        class="absolute bottom-3 end-3 border border-rule bg-ground/70 px-2 py-1 text-[0.65rem] tracking-wide text-muted uppercase"
      >
        {placeholder}
      </span>
    </div>
  )
}
