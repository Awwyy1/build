---
/*
 * Latin and Latin Extended only. The bare entrypoints also ship Cyrillic,
 * Greek and Vietnamese, which no locale here uses; latin-ext is the subset
 * carrying the Icelandic, Polish and Latvian diacritics.
 */
import '@fontsource/zilla-slab/latin-700.css';
import '@fontsource/zilla-slab/latin-ext-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '../styles/global.css';

import CookieBanner from '../components/CookieBanner.astro';
import { company, formatAddress } from '../config/company';
import {
  homeSections,
  localeNames,
  localePath,
  locales,
  useTranslations,
  type Locale,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Marks the current nav item. Use 'careers' on the Careers page. */
  active?: string;
}

const { locale, title, description = '', active } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);

/*
 * Section links are absolute rather than bare fragments, so the same nav
 * works from Careers, which also exists as a page of its own.
 */
const navLinks = homeSections.map((section) => ({
  id: section,
  href: `${home}#${section}`,
  label: t(`nav.${section}`),
}));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* Kept in step with the resolved theme by the script below. */}
    <meta name="theme-color" id="theme-color" content="#efebe0" />

    {/*
      Runs before the page paints, so a visitor who chose dark never sees a
      flash of the light ground first. Inline and un-bundled on purpose: a
      deferred module would arrive too late to prevent it.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var chosen = null;
        try {
          chosen = localStorage.getItem('site.theme');
        } catch (error) {
          /* Storage blocked; fall through to the system preference. */
        }
        if (chosen === 'dark' || chosen === 'light') root.dataset.theme = chosen;

        var dark =
          chosen === 'dark' ||
          (chosen !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', dark ? '#1e2219' : '#efebe0');
      })();
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      /* Tell search engines about every translation of this page. */
      locales.map((alt) => (
        <link rel="alternate" hreflang={alt} href={new URL(localePath(alt), Astro.site)} />
      ))
    }
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:bg-rust focus:px-3 focus:py-2 focus:text-on-rust"
    >
      {t('a11y.skip')}
    </a>

    {/*
      Opaque rather than translucent-and-blurred: against this palette the
      blur was invisible, and a backdrop-filter on a sticky element is a
      known source of scroll stutter on real phones.
    */}
    <header class="sticky top-0 z-40 border-b border-rule bg-ground">
      {/* Height is fixed at 4rem so `.screen` can subtract it exactly. */}
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
        <a href={home} class="font-display text-lg tracking-tight">{company.name}</a>

        {/* Desktop navigation. */}
        <nav class="ms-auto hidden lg:block" aria-label={company.name}>
          <ul class="flex gap-x-6 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.id === active ? 'page' : undefined}
                    class={
                      link.id === active ? 'text-ink' : 'text-muted transition-colors hover:text-ink'
                    }
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <ul class="ms-auto flex gap-x-3 text-sm lg:ms-6" aria-label="Language">
          {
            locales.map((alt) => (
              <li>
                <a
                  href={localePath(alt)}
                  hreflang={alt}
                  aria-current={alt === locale ? 'true' : undefined}
                  class={
                    alt === locale ? 'font-semibold text-ink' : 'text-muted transition-colors hover:text-ink'
                  }
                >
                  {alt.toUpperCase()}
                  <span class="sr-only">, {localeNames[alt]}</span>
                </a>
              </li>
            ))
          }
        </ul>

        {/*
          Desktop only. On a phone the same control lives inside the menu,
          where there is room to label it. Both labels are handed over as
          data attributes so the script stays free of translations.
        */}
        <button
          type="button"
          data-theme-toggle
          class="hidden size-9 items-center justify-center border border-rule text-muted transition hover:border-moss hover:text-ink lg:flex"
          data-label-dark={t('theme.dark')}
          data-label-light={t('theme.light')}
          aria-label={t('theme.dark')}
        >
          <svg class="theme-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
          </svg>
          <svg class="theme-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path
              d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>

        {/* Mobile trigger. Hidden from desktop, where the full nav shows. */}
        <button
          type="button"
          id="nav-toggle"
          class="flex items-center gap-2 border border-rule px-3 py-2 text-sm lg:hidden"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="nav-burger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="sr-only">{t('a11y.menu')}</span>
        </button>
      </div>

      {/*
        Mobile panel. Carries more than the links: the theme control lives
        here rather than in the bar, and the phone number is repeated as a
        tap target because a visitor who opened the menu on a phone is often
        looking for exactly that. Rows reveal in sequence as it opens.
      */}
      <nav id="nav-panel" class="nav-panel border-t border-rule lg:hidden" aria-label={company.name} hidden>
        <div class="mx-auto flex min-h-full max-w-6xl flex-col px-5 pt-2 pb-8">
          <ul>
            {
              navLinks.map((link, i) => (
                <li class="nav-reveal border-b border-rule" style={`--i:${i}`}>
                  <a
                    href={link.href}
                    aria-current={link.id === active ? 'page' : undefined}
                    class={`block py-4 text-lg ${link.id === active ? 'text-ink' : 'text-muted'}`}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          {/* Theme, labelled here where there is width for it. */}
          <button
            type="button"
            data-theme-toggle
            class="nav-reveal flex items-center justify-between border-b border-rule py-4 text-lg text-muted transition hover:text-ink"
            style={`--i:${navLinks.length}`}
            data-label-dark={t('theme.dark')}
            data-label-light={t('theme.light')}
            aria-label={t('theme.dark')}
          >
            <span>{t('theme.label')}</span>
            <span class="flex size-9 items-center justify-center border border-rule">
              <svg class="theme-moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
              </svg>
              <svg class="theme-sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="4.2" />
                <path
                  d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"
                  stroke-linecap="round"
                />
              </svg>
            </span>
          </button>

          {/* Reaching someone, without scrolling the whole page for it. */}
          <div class="nav-reveal mt-auto pt-8" style={`--i:${navLinks.length + 1}`}>
            <div class="flex flex-wrap gap-3">
              <a
                href={`tel:${company.phone.href}`}
                class="flex-1 border border-rule px-4 py-3 text-center text-sm transition hover:border-moss"
              >
                {company.phone.label}
              </a>
              <a
                href={`https://wa.me/${company.phone.href.replace('+', '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-1 items-center justify-center gap-2 bg-rust px-4 py-3 text-sm font-semibold text-on-rust transition hover:brightness-110"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path
                    d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.12-2.9-6.99A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.81.83-3.03-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23a8.2 8.2 0 0 1 8.22 8.24c0 4.54-3.69 8.22-8.23 8.22Zm4.51-6.16c-.25-.12-1.46-.72-1.69-.8-.22-.09-.39-.13-.55.12s-.63.8-.78.97c-.14.16-.28.18-.53.06a6.7 6.7 0 0 1-3.35-2.93c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2.01s.86 2.33.98 2.49c.12.16 1.7 2.59 4.11 3.63 1.53.66 2.13.72 2.9.6.46-.06 1.46-.59 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.11-.22-.17-.47-.29Z"
                  />
                </svg>
                {t('contact.whatsapp')}
              </a>
            </div>

            <dl class="mt-5 space-y-2 text-xs text-muted">
              <div class="flex gap-2">
                <dt class="sr-only">{t('contact.email')}</dt>
                <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
              </div>
              <div>
                <dt class="sr-only">{t('contact.address')}</dt>
                <dd>{formatAddress()}</dd>
              </div>
              <div>
                <dt class="sr-only">{t('contact.hours')}</dt>
                <dd>{t('contact.hours.value')}</dd>
              </div>
            </dl>
          </div>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    {/*
      Legal strip only. Contact details live in the contact section on the
      home page and in the apply block on Careers, so nothing is repeated.
    */}
    <footer class="border-t border-rule bg-surface">
      <div
        class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-5 py-6 text-xs text-muted"
      >
        <span>© {year} {company.name}</span>
        <span>{t('footer.kennitala')} {company.kennitala}</span>
        <button type="button" data-cookie-reopen class="underline transition hover:text-ink">
          {t('cookies.settings')}
        </button>
        <span class="ms-auto">{t('footer.rights')}</span>
      </div>
    </footer>

    <CookieBanner locale={locale} />

    <script>
      /* ---- Theme switch ---- */
      /* Two controls: one in the bar on desktop, one inside the mobile menu. */
      const themeToggles = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle]')];

      if (themeToggles.length > 0) {
        const root = document.documentElement;
        const meta = document.getElementById('theme-color');
        const system = window.matchMedia('(prefers-color-scheme: dark)');

        /* What is on screen right now, whether chosen or inherited. */
        const active = () => root.dataset.theme || (system.matches ? 'dark' : 'light');

        const describe = () => {
          const dark = active() === 'dark';
          const label = dark ? 'labelLight' : 'labelDark';
          themeToggles.forEach((button) => {
            const text = button.dataset[label];
            if (text) button.setAttribute('aria-label', text);
          });
          if (meta) meta.setAttribute('content', dark ? '#1e2219' : '#efebe0');
        };

        themeToggles.forEach((button) =>
          button.addEventListener('click', () => {
            const next = active() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('site.theme', next);
            } catch (error) {
              /* Storage blocked; the choice still holds for this page view. */
            }
            describe();
          })
        );

        /* Until a choice is made the page follows the system, so track it. */
        system.addEventListener('change', describe);
        describe();
      }

      /* ---- Mobile navigation ---- */
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');

      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          // The panel overlays the page; stop the page scrolling underneath.
          document.documentElement.classList.toggle('nav-open', open);
        };

        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );

        // Tapping a link navigates within the page; close so it is visible.
        panel.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          /* Links navigate, so close to reveal where they went. The theme
             row is not a link and must leave the menu standing. */
          if (target.closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !panel.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Leaving mobile width must not strand the panel open.
        const wide = window.matchMedia('(min-width: 1024px)');
        wide.addEventListener('change', (event) => {
          if (event.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
