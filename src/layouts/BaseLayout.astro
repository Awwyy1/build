---
/*
 * Latin and Latin Extended only. The bare entrypoints also ship Cyrillic,
 * Greek and Vietnamese, which no locale here uses; latin-ext is the subset
 * carrying the Icelandic, Polish and Latvian diacritics.
 */
import '@fontsource/zilla-slab/latin-700.css';
import '@fontsource/zilla-slab/latin-ext-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '../styles/global.css';

import CookieBanner from '../components/CookieBanner.astro';
import { company } from '../config/company';
import {
  homeSections,
  localeNames,
  localePath,
  locales,
  useTranslations,
  type Locale,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Marks the current nav item. Use 'careers' on the Careers page. */
  active?: string;
}

const { locale, title, description = '', active } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);

/*
 * Section links are absolute rather than bare fragments, so the same nav
 * works from Careers, which also exists as a page of its own.
 */
const navLinks = homeSections.map((section) => ({
  id: section,
  href: `${home}#${section}`,
  label: t(`nav.${section}`),
}));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* Daylight is the default; the dark value only applies where the system asks for it. */}
    <meta name="theme-color" content="#efebe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e2219" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      /* Tell search engines about every translation of this page. */
      locales.map((alt) => (
        <link rel="alternate" hreflang={alt} href={new URL(localePath(alt), Astro.site)} />
      ))
    }
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:bg-rust focus:px-3 focus:py-2 focus:text-on-rust"
    >
      {t('a11y.skip')}
    </a>

    {/*
      Opaque rather than translucent-and-blurred: against this palette the
      blur was invisible, and a backdrop-filter on a sticky element is a
      known source of scroll stutter on real phones.
    */}
    <header class="sticky top-0 z-40 border-b border-rule bg-ground">
      {/* Height is fixed at 4rem so `.screen` can subtract it exactly. */}
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
        <a href={home} class="font-display text-lg tracking-tight">{company.name}</a>

        {/* Desktop navigation. */}
        <nav class="ms-auto hidden lg:block" aria-label={company.name}>
          <ul class="flex gap-x-6 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.id === active ? 'page' : undefined}
                    class={
                      link.id === active ? 'text-ink' : 'text-muted transition-colors hover:text-ink'
                    }
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <ul class="ms-auto flex gap-x-3 text-sm lg:ms-6" aria-label="Language">
          {
            locales.map((alt) => (
              <li>
                <a
                  href={localePath(alt)}
                  hreflang={alt}
                  aria-current={alt === locale ? 'true' : undefined}
                  class={
                    alt === locale ? 'font-semibold text-ink' : 'text-muted transition-colors hover:text-ink'
                  }
                >
                  {alt.toUpperCase()}
                  <span class="sr-only">, {localeNames[alt]}</span>
                </a>
              </li>
            ))
          }
        </ul>

        {/* Mobile trigger. Hidden from desktop, where the full nav shows. */}
        <button
          type="button"
          id="nav-toggle"
          class="flex items-center gap-2 border border-rule px-3 py-2 text-sm lg:hidden"
          aria-expanded="false"
          aria-controls="nav-panel"
        >
          <span class="nav-burger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
          <span class="sr-only">{t('a11y.menu')}</span>
        </button>
      </div>

      {/* Mobile panel. */}
      <nav id="nav-panel" class="nav-panel border-t border-rule lg:hidden" aria-label={company.name} hidden>
        <ul class="mx-auto max-w-6xl px-5 py-2">
          {
            navLinks.map((link) => (
              <li class="border-b border-rule last:border-b-0">
                <a
                  href={link.href}
                  aria-current={link.id === active ? 'page' : undefined}
                  class={`block py-4 ${link.id === active ? 'text-ink' : 'text-muted'}`}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    {/*
      Legal strip only. Contact details live in the contact section on the
      home page and in the apply block on Careers, so nothing is repeated.
    */}
    <footer class="border-t border-rule bg-surface">
      <div
        class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-5 py-6 text-xs text-muted"
      >
        <span>© {year} {company.name}</span>
        <span>{t('footer.kennitala')} {company.kennitala}</span>
        <button type="button" data-cookie-reopen class="underline transition hover:text-ink">
          {t('cookies.settings')}
        </button>
        <span class="ms-auto">{t('footer.rights')}</span>
      </div>
    </footer>

    <CookieBanner locale={locale} />

    <script>
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-panel');

      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          // The panel overlays the page; stop the page scrolling underneath.
          document.documentElement.classList.toggle('nav-open', open);
        };

        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );

        // Tapping a link navigates within the page; close so it is visible.
        panel.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) setOpen(false);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !panel.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Leaving mobile width must not strand the panel open.
        const wide = window.matchMedia('(min-width: 1024px)');
        wide.addEventListener('change', (event) => {
          if (event.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
