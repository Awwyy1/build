---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company, formatAddress } from '../../config/company';
import { locales, projects, services, useTranslations, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/*
 * Placeholder imagery. The direction leans on real before/after photos, so
 * these stand in as labelled slots rather than stock pictures — swap each
 * one for a photograph of an actual job.
 */
const beforeAfter = 'tex-strata aspect-[4/3]';
---

<BaseLayout
  locale={locale}
  title={`${company.name} — ${t('site.tagline')}`}
  description={t('hero.body')}
>
  {/* ---- Hero ---------------------------------------------------------- */}
  <section class="stratum">
    <div class="mx-auto max-w-5xl px-5 py-20 lg:py-28">
      <p class="text-sm tracking-wide text-rust-text uppercase">{t('hero.eyebrow')}</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl leading-tight sm:text-5xl lg:text-6xl">
        {t('hero.title')}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">{t('hero.body')}</p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#contact"
          class="bg-rust px-6 py-3 font-semibold text-ink hover:brightness-110"
        >
          {t('hero.cta')}
        </a>
        <a href="#projects" class="border border-rule px-6 py-3 hover:border-moss">
          {t('hero.cta2')}
        </a>
      </div>
    </div>
  </section>

  {/* ---- Services: stone courses --------------------------------------- */}
  <section id="services" class="stratum stratum--raised">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-display text-3xl">{t('services.title')}</h2>

      <div class="course mt-8">
        {
          services.map((service) => (
            <article class="grid gap-2 py-6 sm:grid-cols-[14rem_1fr] sm:gap-8">
              <h3 class="font-display text-xl">{t(`service.${service}.title`)}</h3>
              <p class="text-muted">{t(`service.${service}.body`)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- Projects: before / after -------------------------------------- */}
  <section id="projects" class="stratum">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-display text-3xl">{t('projects.title')}</h2>

      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <article>
              <div class="grid grid-cols-2 gap-px bg-rule">
                <figure>
                  <div class={beforeAfter} />
                  <figcaption class="bg-surface px-2 py-1 text-xs text-muted">
                    {t('projects.before')}
                  </figcaption>
                </figure>
                <figure>
                  <div class={beforeAfter} />
                  <figcaption class="bg-surface px-2 py-1 text-xs text-muted">
                    {t('projects.after')}
                  </figcaption>
                </figure>
              </div>

              <p class="mt-4 text-xs tracking-wide text-moss uppercase">
                {t(`project.${project}.kind`)}
              </p>
              <h3 class="mt-1 font-display text-lg">{t(`project.${project}.title`)}</h3>
              <p class="mt-1 text-sm text-rust-text">{t(`project.${project}.meta`)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- About --------------------------------------------------------- */}
  <section id="about" class="stratum stratum--raised">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-display text-3xl">{t('about.title')}</h2>
      <p class="mt-6 max-w-2xl text-lg text-muted">{t('about.body')}</p>
    </div>
  </section>

  {/* ---- Careers ------------------------------------------------------- */}
  <section id="careers" class="stratum">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-display text-3xl">{t('careers.title')}</h2>
      <p class="mt-6 max-w-2xl text-lg text-muted">{t('careers.body')}</p>
      <a
        href={`mailto:${company.emailCareers}`}
        class="mt-8 inline-block bg-rust px-6 py-3 font-semibold text-ink hover:brightness-110"
      >
        {t('careers.cta')}
      </a>
    </div>
  </section>

  {/* ---- Contact ------------------------------------------------------- */}
  <section id="contact" class="stratum stratum--raised">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="font-display text-3xl">{t('contact.title')}</h2>
      <p class="mt-6 max-w-2xl text-lg text-muted">{t('contact.body')}</p>

      <dl class="mt-10 grid gap-6 sm:grid-cols-3">
        <div>
          <dt class="text-sm text-muted">{t('contact.phone')}</dt>
          <dd class="mt-1">
            <a href={`tel:${company.phone.href}`} class="hover:text-rust-text">
              {company.phone.label}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted">{t('contact.email')}</dt>
          <dd class="mt-1">
            <a href={`mailto:${company.email}`} class="hover:text-rust-text">{company.email}</a>
          </dd>
        </div>
        <div>
          <dt class="text-sm text-muted">{t('contact.address')}</dt>
          <dd class="mt-1">{formatAddress()}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
