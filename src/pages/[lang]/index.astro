---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSlideshow from '../../components/HeroSlideshow.astro';
import Photo from '../../components/Photo.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { company, formatAddress } from '../../config/company';
import { projectPhotos, sectionPhotos } from '../../config/media';
import { locales, localePath, projects, services, useTranslations, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/*
 * Figures the company can stand behind today. Deliberately no "years in
 * business": the company is young, and its case is the work it has done,
 * not how long it has been at it.
 */
const stats = [
  { value: '20+', label: t('about.stat1') },
  { value: '20+', label: t('about.stat2') },
];

/* Pre-fills the subject so applications stay out of the general inbox. */
const applyHref = `mailto:${company.emailCareers}?subject=${encodeURIComponent(
  `${t('careers.cta')} ${company.name}`
)}`;
---

<BaseLayout
  locale={locale}
  title={`${company.name}, ${t('site.tagline')}`}
  description={t('hero.body')}
>
  {/* ---- Hero: full screen, photography behind the headline ------------ */}
  <section class="relative flex screen items-center overflow-hidden">
    <HeroSlideshow locale={locale} />

    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 py-24">
      <p class="text-sm tracking-wide text-rust-text uppercase">{t('hero.eyebrow')}</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl leading-tight sm:text-5xl lg:text-6xl">
        {t('hero.title')}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{t('hero.body')}</p>

      {/*
        The quote button is parked for now; projects carry the pitch better
        while the photography is still going in. Its string is kept in the
        catalogue so it can come back without a re-translation.
      */}
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="bg-rust px-6 py-3 font-semibold text-on-rust transition hover:brightness-110"
        >
          {t('hero.cta2')}
        </a>
      </div>
    </div>
  </section>

  {/* ---- Services: full screen, photo alongside the trades ------------- */}
  <section id="services" class="stratum stratum--raised scroll-mt-16">
    <div class="mx-auto grid screen max-w-6xl items-center gap-10 px-5 py-20 lg:grid-cols-2 lg:gap-16">
      <div class="order-2 h-full min-h-[22rem] lg:order-1">
        <Photo
          src={sectionPhotos.services}
          alt={t('services.photo.alt')}
          placeholder={t('media.placeholder')}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>

      <div class="order-1 lg:order-2">
        <h2 class="font-display text-3xl sm:text-4xl">{t('services.title')}</h2>
        <p class="mt-3 text-muted">{t('services.lead')}</p>

        <div class="course mt-8">
          {
            services.map((service) => (
              <article class="py-5">
                <h3 class="font-display text-xl">{t(`service.${service}.title`)}</h3>
                <p class="mt-2 text-muted">{t(`service.${service}.body`)}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---- Projects: full screen, three jobs ----------------------------- */}
  <section id="projects" class="stratum scroll-mt-16">
    <div class="mx-auto flex screen max-w-6xl flex-col justify-center px-5 py-20">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl">{t('projects.title')}</h2>
        <p class="mt-3 text-muted">{t('projects.lead')}</p>
      </div>

      {/*
        Stacked on a phone, a photo-then-caption card leaves every block of
        text sitting between two photographs, and it stops being obvious
        which one it belongs to. Below `sm` the heading leads instead, so
        each card opens with an unmistakable marker, and a rule separates
        one card from the next. Side by side there is no ambiguity, so the
        photograph goes back on top.
      */}
      <div class="mt-10 grid gap-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
        {
          projects.map((project) => (
            <article class="flex flex-col gap-4 border-t border-rule pt-10 first:border-t-0 first:pt-0 sm:gap-0 sm:border-t-0 sm:pt-0">
              <div class="order-2 sm:order-1">
                <ProjectGallery
                  locale={locale}
                  photos={projectPhotos[project]}
                  label={t(`project.${project}.title`)}
                />
              </div>

              <div class="order-1 sm:order-2 sm:mt-4">
                <p class="text-xs tracking-wide text-moss uppercase">
                  {t(`project.${project}.kind`)}
                </p>
                <h3 class="mt-1 font-display text-lg">{t(`project.${project}.title`)}</h3>
                <p class="mt-1 text-sm text-rust-text">{t(`project.${project}.status`)}</p>
                <p class="mt-3 text-sm text-muted">{t(`project.${project}.body`)}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- About: full screen, team photograph --------------------------- */}
  <section id="about" class="stratum stratum--raised scroll-mt-16">
    <div class="mx-auto grid screen max-w-6xl items-center gap-10 px-5 py-20 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-display text-3xl sm:text-4xl">{t('about.title')}</h2>
        <p class="mt-6 text-lg text-muted">{t('about.body')}</p>
        <p class="mt-4 text-lg text-muted">{t('about.body2')}</p>

        <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
          {
            stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="block font-display text-3xl text-ink">{stat.value}</span>
                  <span class="mt-1 block text-xs tracking-wide text-muted uppercase">
                    {stat.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="h-full min-h-[22rem]">
        <Photo
          src={sectionPhotos.about}
          alt={t('about.photo.alt')}
          placeholder={t('media.placeholder')}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
    </div>
  </section>

  {/*
    ---- Careers: on the landing, ahead of contact ----------------------
    About puts its photograph on the right, so this one goes left and the
    bands keep alternating down the page. The text stays first in the
    source, which is the order it should be read in when the columns stack.
  */}
  <section id="careers" class="stratum scroll-mt-16">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 lg:grid-cols-2 lg:gap-16">
      <div class="lg:order-2">
        <h2 class="font-display text-3xl sm:text-4xl">{t('careers.title')}</h2>
        <p class="mt-6 text-lg text-muted">{t('careers.lead')}</p>
        <p class="mt-4 text-muted">{t('careers.teaser')}</p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={applyHref}
            class="bg-rust px-6 py-3 font-semibold text-on-rust transition hover:brightness-110"
          >
            {t('careers.cta')}
          </a>
          <a
            href={localePath(locale, 'careers')}
            class="border border-rule px-6 py-3 transition hover:border-moss"
          >
            {t('careers.more')}
          </a>
        </div>
      </div>

      <div class="h-full min-h-[20rem] lg:order-1">
        <Photo
          src={sectionPhotos.careers}
          alt={t('careers.photo.alt')}
          placeholder={t('media.placeholder')}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
    </div>
  </section>

  {/* ---- Contact: the page's only copy of the details ------------------ */}
  <section id="contact" class="stratum--raised scroll-mt-16">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="font-display text-3xl sm:text-4xl">{t('contact.title')}</h2>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t('contact.body')}</p>

      <dl class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs tracking-wide text-muted uppercase">{t('contact.phone')}</dt>
          <dd class="mt-2">
            <a href={`tel:${company.phone.href}`} class="transition hover:text-rust-text">
              {company.phone.label}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-muted uppercase">{t('contact.email')}</dt>
          <dd class="mt-2">
            <a href={`mailto:${company.email}`} class="transition hover:text-rust-text">
              {company.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-muted uppercase">{t('contact.address')}</dt>
          <dd class="mt-2">{formatAddress()}</dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-muted uppercase">{t('contact.hours')}</dt>
          <dd class="mt-2">{t('contact.hours.value')}</dd>
        </div>
      </dl>

    </div>
  </section>
</BaseLayout>
